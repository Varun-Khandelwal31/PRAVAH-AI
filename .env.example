# PRAVAHAI Environment Configuration Template
# Copy this file to .env: cp .env.example .env

# --- Voice & AI Alerting Credentials ---
# Primary Voice API: Sarvam AI text-to-speech (free self-serve fallback from dashboard.sarvam.ai)
# Leave empty to automatically use offline Microsoft Edge TTS (edge-tts, zero-cost, no key required)
SARVAM_API_KEY=

# Enterprise Voice Partner (Optional): Venue credentials provided by Gnani AI on-site team
GNANI_API_KEY=
GNANI_ENDPOINT=

# Generative Incident Summaries (Optional): Google Gemini 1.5 Flash for Hindi post-incident reports
# If empty, incident summaries are safely omitted without errors
GEMINI_API_KEY=

# --- Pipeline Execution Tuning ---
# Ingestion mode: 'simulator' (default synthetic crowd), 'video' (SOURCE_VIDEO), 'timeline' (zero-compute backup), 'webcam'
SOURCE_MODE=simulator

# Video source path when SOURCE_MODE=video
SOURCE_VIDEO=sample_data/crowd.mp4

# Frame skip for YOLO person detector on resource-constrained CPUs (0 = every frame, 1 = every second frame)
FRAME_SKIP=0
